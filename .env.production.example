# Used by `docker compose build` for the web image's build args (see
# docker-compose.yml). Copy to .env before building.

# Public URL your browser will reach the backend at — through your reverse
# proxy, e.g. https://api.yourdomain.com — NOT an internal container address.
VITE_API_BASE_URL=https://api.yourdomain.com

# Same Google OAuth "Web application" client ID as GOOGLE_WEB_CLIENT_ID in
# apps/backend/.env.production — must match exactly, or the backend will
# reject the ID token this issues as having the wrong audience.
VITE_GOOGLE_WEB_CLIENT_ID=1047967568696-9n47vv1rta5tf87vpmg8ts06lu2kaqvk.apps.googleusercontent.com
