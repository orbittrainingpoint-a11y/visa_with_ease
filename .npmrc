# Windows has a 260-character MAX_PATH limit. pnpm's nested store folder names
# (node_modules/.pnpm/<name>@<version>_<peer-dep-hash>/...) can exceed that for
# packages with many peer deps (this project's Android native build hit it,
# failing to launch a CMake-generated prefab_command.bat with "file not found"
# even though the file existed — a classic Windows path-length symptom).
# This caps the folder name length pnpm will generate before switching to a
# short hashed alias instead, without changing the (safer, isolated) default
# node-linker — unlike node-linker=hoisted, which was tried and reverted here
# because it broke devDependency build-script resolution (expo-module CLI).
virtual-store-dir-max-length=30
