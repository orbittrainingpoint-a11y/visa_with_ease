# VisaIQ Backend — Production environment template.
# Copy to apps/backend/.env.production, fill in real values, and reference it
# from docker-compose.yml (already wired to read this file).

# ── AI Provider ───────────────────────────────────────────────────────────────
# Leave AI_MOCK=true until you have a real key — chat still works, just not
# backed by a live model.
ANTHROPIC_API_KEY=
AI_MOCK=true

# ── Firebase / Firestore ──────────────────────────────────────────────────────
# Mount your real service-account JSON at this exact path (docker-compose.yml
# already has the volume line for it) — without it the backend silently falls
# back to an in-memory store that resets on every restart.
FIREBASE_SERVICE_ACCOUNT_PATH=/app/firebase-service-account.json

# ── Google Sign-In ────────────────────────────────────────────────────────────
# Same "Web application" OAuth client used by both the mobile app and the web
# app's Google button. Add your production web domain to this client's
# "Authorized JavaScript origins" in Google Cloud Console, or sign-in will be
# rejected even with the right client ID.
GOOGLE_WEB_CLIENT_ID=335126006793-dam19a7em0stu9k4l1i7hj3fgufe2e41.apps.googleusercontent.com

# ── JWT ────────────────────────────────────────────────────────────────────────
# Generate a real one — do not ship the dev placeholder:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ── Demo login ────────────────────────────────────────────────────────────────
# MUST be false (or unset) in production — /auth/demo hands out real tokens,
# including platform_admin, with no password check.
ENABLE_DEMO_LOGIN=false

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001

# ── CORS ───────────────────────────────────────────────────────────────────────
# Your real web domain(s), comma-separated. No localhost entries in production.
CORS_ORIGINS=https://yourdomain.com

# ── Not yet wired (see task list) — leave blank until each feature is built ───
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# SENDGRID_API_KEY=
# FCM credentials — same firebase-service-account.json above once wired
