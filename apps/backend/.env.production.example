# VisaIQ Backend — Production environment template.
# Copy to apps/backend/.env.production, fill in real values, and reference it
# from docker-compose.yml (already wired to read this file).

# ── AI Provider ───────────────────────────────────────────────────────────────
# Leave AI_MOCK=true until you have a real key — chat still works, just not
# backed by a live model. This same flag also gates the document-scan AI
# below, so both go live together once you set it to false.
# NOTE: AI_MOCK does NOT gate dev-only auth conveniences (see
# ENABLE_DEV_AUTH_BYPASS below) — it used to, and that leaked live
# password-reset links/OTP codes to anyone on any deployment that (like this
# template) leaves AI_MOCK=true. Keep it false-independent going forward.
ANTHROPIC_API_KEY=
AI_MOCK=true

# Optional — which Claude model answers chat. Defaults to Haiku 4.5, and
# that's the right call for this feature, not a placeholder to upgrade
# later: every chat reply is already grounded in a hard-coded system prompt
# plus the user's real application + requirements data (see aiProviders.ts),
# and the highest-traffic questions (score, "how do I apply") never reach a
# model at all — they're answered straight from that same data with zero
# API cost. That's a narrow, well-scoped Q&A job Haiku handles fine at a
# fraction of Opus's cost. Reach for claude-sonnet-5 only if you see real
# quality complaints on nuanced questions; Opus (claude-opus-5) is priced
# for much harder reasoning tasks than "answer a visa FAQ from a document
# you were just handed" and would be paying for headroom this app doesn't
# use.
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Real document-scan analysis (passport, bank statement, PDF understanding)
# in /audit — tried FIRST, before Gemini below, once AI_MOCK=false. Get a
# key and add credits/raise the spending limit at https://console.x.ai
# (a key with no usable credits authenticates fine but every real call
# fails with a "permission-denied" billing error, not an auth error — check
# billing first if document scans keep silently falling back to Gemini or
# the OCR-text heuristic).
# UNVERIFIED as of when this was added: authenticated successfully against
# the endpoint below in a live connectivity test, but the account had no
# credits, so the actual image-analysis request/response shape (grokVision.ts)
# has never been exercised end to end — xAI's own docs and third-party
# references disagree on it. Test with a real document once credits are
# added, and check grokVision.ts's own comments before assuming it's correct.
XAI_API_KEY=
# Optional — defaults to grok-4 (confirmed to authenticate; NOT yet
# confirmed to accept image input — see the note above). xAI's docs also
# reference grok-4.3/grok-4.7 for vision via a different endpoint; try one
# of those here first if grok-4 turns out not to support images.
XAI_VISION_MODEL=

# Powers two things once AI_MOCK=false: the chat fallback provider (if
# ANTHROPIC_API_KEY is unset) and real document-scan analysis (passport,
# bank statement, PDF understanding) in /audit when Grok above isn't
# configured or its call fails. Without this key, document scanning still
# works but only via the on-device OCR-text heuristic — no real AI vision.
# Get a key at https://aistudio.google.com/apikey
GOOGLE_GEMINI_API_KEY=
# Optional — defaults to GEMINI_MODEL, or gemini-3.6-flash if that's unset too.
# Google retires old model names without much notice (gemini-1.5-flash and
# gemini-2.0-flash both stopped working during this project) — if document
# scanning or chat suddenly starts failing with a 404 "model not found", that
# is almost certainly why. Check https://ai.google.dev/gemini-api/docs/models
# for the current name and set it here explicitly rather than trusting a
# hardcoded default.
# Must be a model that supports image + PDF input.
GEMINI_VISION_MODEL=

# ── Firebase / Firestore ──────────────────────────────────────────────────────
# Mount your real service-account JSON at this exact path (docker-compose.yml
# already has the volume line for it) — without it the backend silently falls
# back to an in-memory store that resets on every restart.
FIREBASE_SERVICE_ACCOUNT_PATH=/app/firebase-service-account.json

# ── Email (Gmail SMTP) ─────────────────────────────────────────────────────────
# SMTP_USER is the Gmail address that sends verification/2FA/reset emails.
# SMTP_PASS is a Gmail *App Password*, not your normal Gmail password — Google
# blocks plain-password SMTP login. Generate one at:
#   Google Account -> Security -> 2-Step Verification -> App passwords
# (requires 2-Step Verification to be enabled on that Gmail account first).
# Leave both blank and forgot-password/email-verification/2FA codes simply
# won't be delivered anywhere (they are NOT returned in the API response
# unless you also set ENABLE_DEV_AUTH_BYPASS=true — see below). Set real SMTP
# credentials before going live, or those three flows are non-functional.
SMTP_USER=
SMTP_PASS=
# Optional — defaults to SMTP_USER if unset. What recipients see as the sender.
SMTP_FROM=

# Public URL of the web app — used to build the password-reset link that gets
# emailed. Must be reachable by whoever clicks it.
FRONTEND_URL=https://www.visawithease.com

# ── Google Sign-In ────────────────────────────────────────────────────────────
# Web app's OAuth client (a "Web application" type client). Add your
# production web domain to this client's "Authorized JavaScript origins" in
# Google Cloud Console, or sign-in will be rejected with "no registered
# origin" even with the right client ID. Same value also fills
# VITE_GOOGLE_WEB_CLIENT_ID (see root .env.production.example) since both the
# web frontend and the backend's token-audience check need to agree.
# Recommended: use a Web client from the SAME Firebase project the mobile app
# (google-services.json) is registered under, so there's one client to manage
# instead of two — that's the value below.
GOOGLE_WEB_CLIENT_ID=1047967568696-9n47vv1rta5tf87vpmg8ts06lu2kaqvk.apps.googleusercontent.com

# Only set this if mobile uses a genuinely DIFFERENT OAuth client than
# GOOGLE_WEB_CLIENT_ID above (the backend accepts either as a valid token
# audience). Leave blank if, like the default above, both platforms share one
# client ID.
GOOGLE_WEB_CLIENT_ID_MOBILE=

# ── JWT ────────────────────────────────────────────────────────────────────────
# Generate a real one — do not ship the dev placeholder:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ── Demo login ────────────────────────────────────────────────────────────────
# MUST be false (or unset) in production — /auth/demo hands out real tokens,
# including platform_admin, with no password check.
ENABLE_DEMO_LOGIN=false

# MUST be false (or unset) in production — when true, forgot-password returns
# the real reset URL directly in the API response instead of emailing it, and
# email-verification/2FA return the real code the same way (or accept
# verification with no code on file at all). Only ever set true in local dev
# alongside AI_MOCK=true, when you have no SMTP configured and want to see the
# code/link without checking an inbox.
ENABLE_DEV_AUTH_BYPASS=false

# ── Server ────────────────────────────────────────────────────────────────────
# The container runs with network_mode: host (see docker-compose.yml), so
# this is the literal host port your reverse proxy connects to directly —
# not an internal container port behind a published mapping. Pick whatever's
# actually free on your VPS (check with `ss -tlnp`).
PORT=3011

# ── CORS ───────────────────────────────────────────────────────────────────────
# Your real web domain(s), comma-separated. No localhost entries in production.
CORS_ORIGINS=https://yourdomain.com

# ── Not yet wired (see task list) — leave blank until each feature is built ───
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# SENDGRID_API_KEY=
# FCM credentials — same firebase-service-account.json above once wired
