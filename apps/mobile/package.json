{
  "name": "@visaiq/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "cross-env EXPO_OFFLINE=1 EXPO_NO_TELEMETRY=1 expo start --lan --clear --port 8082",
    "start:lan": "cross-env EXPO_OFFLINE=1 EXPO_NO_TELEMETRY=1 expo start --lan --clear --port 8082",
    "start:tunnel": "expo start --tunnel --clear --port 8082",
    "android": "expo run:android",
    "build": "echo \"Use EAS Build after native credentials are configured\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "echo \"mobile: no tests yet\"",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@babel/runtime": "^7.26.0",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^14.0.1",
    "expo": "~54.0.35",
    "expo-asset": "~12.0.13",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-document-picker": "~14.0.8",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-local-authentication": "~17.0.8",
    "expo-modules-core": "~3.0.30",
    "expo-print": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "react": "^19.1.0",
    "react-native": "^0.81.5",
    "react-native-svg": "^15.12.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.0",
