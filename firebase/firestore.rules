rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function ownsApplication(applicationId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/applications/$(applicationId))
        && get(/databases/$(database)/documents/applications/$(applicationId)).data.ownerId == request.auth.uid;
    }

    match /applications/{applicationId} {
      allow read, create, update: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow delete: if false;
    }

    match /audits/{documentId} {
      allow read: if ownsApplication(resource.data.applicationId);
      allow create, update: if ownsApplication(request.resource.data.applicationId);
      allow delete: if false;
    }

    match /requirementsCache/{cacheKey} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /accessGrants/{grantId} {
      allow read, create, update: if ownsApplication(request.resource.data.applicationId);
      allow delete: if false;
    }

    match /bookings/{bookingId} {
      allow read, create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
  }
}
